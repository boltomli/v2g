# LLM provider API key (OpenAI-compatible endpoint)
V2G_LLM_API_KEY=sk-...
V2G_LLM_BASE_URL=https://api.openai.com/v1
V2G_LLM_MODEL=gpt-4o

# Default max output tokens per LLM response (GDScript bundles need the headroom).
# If logs show `chat output hit max_tokens` / finish=length, raise this toward
# your provider's completion-token cap — reasoning models spend it on thinking too.
V2G_LLM_MAX_TOKENS=32768

# Path to Godot 4.x executable (used to verify/run projects)
V2G_GODOT_PATH=godot

# Max seconds for a single analysis (detail mode); longer input is trimmed to this
V2G_MAX_DURATION=120

# Seconds between extracted frames (fast mode). E.g. 2.0 = 1 frame every 2 seconds
V2G_FRAME_INTERVAL=2.0

# Hard cap on upload size in MB — over it: compress once, then split to fit (detail mode)
V2G_VIDEO_MAX_MB=20

# Max keyframes to send to LLM (long video cap). Default: 40
V2G_FRAME_BUDGET=40

# ffmpeg scene-detect sensitivity (0.0–1.0). Lower = more frames. Default: 0.3
V2G_SCENE_THRESHOLD=0.3

# Seconds per analysis chunk for long videos in detail mode. Default: 60 (1 min)
V2G_CHUNK_DURATION=60

# Local image generation (Qwen-Image-2.1) — install with: uv sync --extra imagegen
# Pre-warm the ~23 GB model bundle ahead of the first run:
#   .venv/Scripts/python -c "from v2g.llm.image_gen import prepare_model; prepare_model()"
# V2G_IMAGEGEN_PROVIDER=qwen   # "" = disabled (assets stay raw video frames)
# V2G_IMAGEGEN_STYLE=          # style prefix prepended to every image-gen prompt
# V2G_IMAGEGEN_STEPS=20        # denoising steps (Qwen's default is 40)
# V2G_IMAGEGEN_MAX_SIDE=1024   # longest output edge (lower = less RAM/VRAM)
# V2G_IMAGEGEN_MODEL=          # optional model root override (diffusers dir / HF id)
# V2G_IMAGEGEN_AUTORESTYLE=1   # re-draw assets even without -i (prompt = design.style)
# V2G_IMAGEGEN_AB=1            # opt in: per asset draw text-only + source-referenced candidates, judge picks one
