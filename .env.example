# LLM provider API key (OpenAI-compatible endpoint)
V2G_LLM_API_KEY=sk-...
V2G_LLM_BASE_URL=https://api.openai.com/v1
V2G_LLM_MODEL=gpt-4o

# Path to Godot 4.x executable (used to verify/run projects)
V2G_GODOT_PATH=godot

# Max video duration in seconds to extract frames from
V2G_MAX_DURATION=120

# Number of key frames to extract from the video (fast mode)
V2G_FRAME_COUNT=16

# Max video file size in MB for direct upload to LLM (detail mode)
V2G_VIDEO_MAX_MB=20
