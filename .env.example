# LLM provider API key (OpenAI-compatible endpoint)
V2G_LLM_API_KEY=sk-...
V2G_LLM_BASE_URL=https://api.openai.com/v1
V2G_LLM_MODEL=gpt-4o

# Default max output tokens per LLM response (GDScript bundles need the headroom).
# If logs show `chat output hit max_tokens` / finish=length, raise this toward
# your provider's completion-token cap — reasoning models spend it on thinking too.
V2G_LLM_MAX_TOKENS=32768

# Path to Godot 4.x executable (used to verify/run projects)
V2G_GODOT_PATH=godot

# Max seconds for a single analysis (detail mode); longer input is trimmed to this
V2G_MAX_DURATION=120

# Seconds between extracted frames (fast mode). E.g. 2.0 = 1 frame every 2 seconds
V2G_FRAME_INTERVAL=2.0

# Hard cap on upload size in MB — over it: compress once, then split to fit (detail mode)
V2G_VIDEO_MAX_MB=20

# Max keyframes to send to LLM (long video cap). Default: 40
V2G_FRAME_BUDGET=40

# ffmpeg scene-detect sensitivity (0.0–1.0). Lower = more frames. Default: 0.3
V2G_SCENE_THRESHOLD=0.3

# Seconds per analysis chunk for long videos in detail mode. Default: 60 (1 min)
V2G_CHUNK_DURATION=60

# Vision model must confirm each extracted asset frame really shows the asset
# (and locates the subject for 512×512 character/object sprites). 0 = unchecked.
# V2G_ASSET_VERIFY=1

# Local image generation (Qwen-Image-2.1) — install with: uv sync --extra imagegen
# Pre-warm the ~23 GB model bundle ahead of the first run:
#   .venv/Scripts/python -c "from v2g.llm.image_gen import prepare_model; prepare_model()"
# V2G_IMAGEGEN_PROVIDER=qwen   # "" = stage 2 redraw skipped (assets stay raw frames, reported)
# V2G_IMAGEGEN_STYLE=          # style prefix prepended to every image-gen prompt
# V2G_IMAGEGEN_STEPS=20        # denoising steps (Qwen's default is 40)
# V2G_IMAGEGEN_MAX_SIDE=1024   # longest output edge (lower = less RAM/VRAM)
# V2G_IMAGEGEN_MODEL=          # optional model root override (diffusers dir / HF id)
# V2G_IMAGEGEN_AB=1            # opt in: per asset draw text-only AND source-referenced candidates, judge picks one

# Voice-over for narration + dialogue — same endpoint as the LLM (unset = off)
# V2G_TTS_MODEL=gpt-4o-mini-tts      # preset voices: /audio/speech first, chat protocol if the route is missing
# V2G_TTS_MODEL=mimo-v2.5-tts-voicedesign  # one designed voice per character + narrator, derived from the design (chat protocol only)
# V2G_TTS_VOICES=           # preset mode: first voice speaks narration + sets chat-audio audio.voice; characters rotate the rest (ignored in voice-design mode)
# V2G_TTS_TEXT=zh           # zh = speak the Chinese line (default) | source = verbatim transcript line

# Background music (unset = off)
# V2G_MUSIC_MODEL=           # api: music-capable chat model | llm: code-writing model | acestep: DiT id
# V2G_MUSIC_PROVIDER=api     # api = OpenAI chat audio | llm = model writes synth code (executes it locally!) | acestep = local ACE-Step REST
# V2G_MUSIC_ACESTEP_URL=http://127.0.0.1:8001   # running acestep-api (start/stop it yourself)
# V2G_MUSIC_DURATION=60      # seconds per track

# Sound effects — the text model writes one synthesis script per cue, run locally
# event + per-line cues derived by one cached LLM call; executes model-written code
# V2G_SFX_PROVIDER=llm        # llm = local synthesis scripts; unset = off
